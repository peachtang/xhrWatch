{
  "name": "xhr-watch",
  "version": "0.1.0",
  "private": true,
  "description": "Local dev backend that collects XHR events from market260813 AOP hook",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch src/index.ts\"",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && tsc --project frontend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.0",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10"
  }
}
